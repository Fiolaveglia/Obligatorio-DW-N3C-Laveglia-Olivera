@model Obligatorio.LogicaAplicacion.DTO.DtoHistoriaAlta
@using Obligatorio.LogicaNegocio.Entidades


<h1>Crear historia</h1>

@if(ViewBag.Error != null)
{
    <div class="alert alert-danger" role="alert">
        @ViewBag.Error
    </div>
}

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Titulo"></label>
        <input asp-for="Titulo" class="form-control" />
        <span asp-validation-for="Titulo" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Sinopsis"></label>
        <textarea asp-for="Sinopsis" class="form-control"></textarea>
        <span asp-validation-for="Sinopsis" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label>Categorías</label>
        @foreach (var categoria in (List<Categoria>)ViewBag.Categorias)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="@categoria.Id" name="CategoriasIds" id="categoria_@categoria.Id" />
                <label class="form-check-label" for="categoria_@categoria.Id">@categoria.Nombre</label>
            </div>
        }
    </div>    
    <div class="form-group">
        <label asp-for="TituloCapituloInicial">Título del capítulo inicial</label>
        <input asp-for="TituloCapituloInicial" class="form-control" />
        <span asp-validation-for="TituloCapituloInicial" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TextoCapituloInicial">Texto del capítulo inicial</label>
        <textarea asp-for="TextoCapituloInicial" class="form-control"></textarea>
        <span asp-validation-for="TextoCapituloInicial" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Crear</button>
</form>
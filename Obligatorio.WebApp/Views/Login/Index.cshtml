@model Obligatorio.LogicaAplicacion.DTO.DtoLogin

<h1>Iniciar sesión</h1>

@if (ViewBag.Error != null)
{
    <div>@ViewBag.Error</div>
}

<form asp-action="Index" method="post" style="max-width: 500px">

    <div class="form-group mb-3">
        <label asp-for="NombreUsuario"></label>
        <input asp-for="NombreUsuario" class="form-control" />
        <span asp-validation-for="NombreUsuario" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Contrasenia"></label>
        <input asp-for="Contrasenia" type="password" class="form-control" />
        <span asp-validation-for="Contrasenia" class="text-danger"></span>

    </div>

    <button type="submit" class="btn btn-primary">Ingresar</button>

</form>